{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithThreadId",
      "WithMachineName"
    ],
    "Properties": {
      "Application": "OrganizationalStructure.API"
    }
  },
  "ConnectionStrings": {
    "OrganizationalStructureDb": "placeholder",
    "Redis": ""
  },
  "AllowedHosts": "*"
}